# Copy to repository root as .env.m0.local and DO NOT COMMIT it.
# This file contains topology identifiers, but must never contain passwords or tokens.

# Stable public labels. These are safe to publish.
NODE_LABEL=spark-a
REMOTE_LABEL=spark-b

# Local and remote high-speed data interfaces.
DATA_IFACE=enp1s0f1np1
REMOTE_DATA_IFACE=enp1s0f1np1

# Management path used by the bootstrap network verifier.
MGMT_IFACE=enP7s7
PEER_MGMT_IP=198.51.100.11

# Private topology values. The publish command redacts them.
LOCAL_DATA_IP=192.0.2.10
PEER_DATA_IP=192.0.2.11
REMOTE_HOST=user@192.0.2.11
REMOTE_NODE_HOSTNAME=private-spark-b-hostname
REMOTE_REPO_ROOT=/home/user/ai-inference-platform
SSH_OPTS='-o BatchMode=yes -o ConnectTimeout=10'

# Images actually used by M0. Pin digests where possible.
GPU_TEST_IMAGE=nvcr.io/nvidia/pytorch@sha256:REPLACE_ME
# Lifecycle-only runtime probe; pinning this trivial image is optional for M0.
RUNTIME_SMOKE_IMAGE=hello-world:latest
VLLM_IMAGE=
VLLM_MODEL=

# Optional directory containing all_reduce_perf/all_gather_perf.
NCCL_TEST_BIN_DIR=

# Dedicated evidence roots. The safety gate intentionally requires these exact paths.
# Private data is gitignored; sanitized data is publishable.
PRIVATE_EVIDENCE_ROOT=artifacts/m0-private
PUBLIC_EVIDENCE_ROOT=benchmarks/raw-results/m0-platform-qualification

# Leave empty to use UTC timestamp, for example 20260805T024500Z.
RUN_ID=

# TCP baseline settings.
IPERF_SECONDS=30
IPERF_PARALLEL=4
PING_COUNT=20

# 0 keeps collection concise. Set to 1 only when debugging NIC/RDMA counters.
COLLECT_FULL_NIC_STATS=0

# Additional literal strings, identities, or path prefixes to redact, separated by commas.
# Every item must be at least four characters to prevent over-broad replacement.
# Lists may not contain line breaks; explicitly configured usernames may not be generic identities.
# Record both capture-node hostnames: publication may run on a third workstation.
PRIVATE_LITERALS=
PRIVATE_HOSTNAMES=private-spark-a-hostname,private-spark-b-hostname
PRIVATE_USERNAMES=
PRIVATE_PATH_PREFIXES=
PRIVATE_REGISTRY_PREFIX=
PRIVATE_MODEL_ID=

# Never add secrets here:
# HF_TOKEN, NGC_API_KEY, DOCKER_AUTH_CONFIG, SSH keys, passwords, cloud credentials.
