{
  "spec": {
    "template": {
      "spec": {
        "terminationGracePeriodSeconds": 120,
        "nodeSelector": {
          "kubernetes.io/hostname": "spark-f603"
        },
        "initContainers": null,
        "containers": [
          {
            "name": "vllm-container",
            "command": ["vllm"],
            "args": [
                "serve",
                "/models/Qwen2.5-7B-Instruct",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--served-model-name",
                "qwen2.5-7b-instruct-medium",
                "--dtype",
                "bfloat16",
                "--generation-config",
                "vllm",
                "--max-num-seqs",
                "128",
                "--max-model-len",
                "8192",
                "--gpu-memory-utilization",
                "0.25"
            ],
            "volumeMounts": [
              {
                "mountPath": "/models/Qwen3-8B",
                "$patch": "delete"
              },
              {
                "name": "model-volume",
                "mountPath": "/models/Qwen2.5-7B-Instruct",
                "readOnly": true
              }
            ],
            "resources": {
              "limits": {
                "memory": "64Gi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "model-volume",
            "persistentVolumeClaim": null,
            "hostPath": {
              "path": "/home/tensoku/models/Qwen2.5-7B-Instruct",
              "type": "Directory"
            }
          },
          {
            "name": "source-models-volume",
            "$patch": "delete"
          }
        ]
      }
    }
  }
}
