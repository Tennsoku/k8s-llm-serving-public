{"kind": "start", "utc": "2026-09-07T06:19:27.599753+00:00", "argv": ["artifacts/private/m2p/20260904-m2p-lora-r01/raw/score/npc-merchant-s080/diagnostic-20260907.py", "artifacts/private/m2p/20260904-m2p-lora-r01/raw/score/npc-merchant-s080/diagnostic-20260907.jsonl"], "source": "\"\"\"Exploratory saved-adapter diagnosis; no training and no changes to the scoring gate.\n\nRun from repository root inside the existing training container, with a new JSONL\noutput path as argv[1]. Each observation is flushed immediately; failures persist.\n\"\"\"\nimport contextlib\nimport json\nimport runpy\nimport sys\nimport traceback\nfrom datetime import datetime, timezone\nfrom importlib.metadata import version\nfrom pathlib import Path\n\nout = Path(sys.argv[1]).open(\"x\", encoding=\"utf-8\")\n\n\ndef emit(record):\n    text = json.dumps(record, ensure_ascii=False)\n    out.write(text + \"\\n\")\n    out.flush()\n    print(text, flush=True)\n\n\ntry:\n    import torch\n    from peft import PeftModel\n    from transformers import AutoModelForCausalLM\n\n    m = runpy.run_path(\"scripts/experiments/m2p_lora.py\")\n    root = Path(\"artifacts/private/m2p/20260904-m2p-lora-r01/raw\")\n    train = m[\"read_jsonl\"](root / \"datasets/npc-merchant.train.jsonl\")\n    evaluation = m[\"read_jsonl\"](root / \"datasets/npc-merchant.eval.jsonl\")\n    adapter = str(root / \"training/npc-merchant-s080/adapter\")\n    emit({\"kind\": \"start\", \"utc\": datetime.now(timezone.utc).isoformat(), \"argv\": sys.argv,\n          \"source\": Path(__file__).read_text(), \"purpose\": \"exploratory, not acceptance\",\n          \"adapter\": adapter, \"versions\": {k: version(k) for k in (\"torch\", \"transformers\", \"peft\")}})\n    tok = m[\"load_tokenizer\"]()\n    base = AutoModelForCausalLM.from_pretrained(m[\"BASE_MODEL\"], local_files_only=True, dtype=torch.bfloat16)\n    model = PeftModel.from_pretrained(base, adapter, is_trainable=False).eval().to(\"cuda\")\n    emit({\"kind\": \"loaded\", \"active_adapters\": model.active_adapters,\n          \"attention\": model.config._attn_implementation, \"use_cache\": model.config.use_cache,\n          \"adapter_dtype\": str(next(p for n, p in model.named_parameters() if \"lora_A\" in n).dtype)})\n\n    # Recompute completion-only loss after reload, with/without training's BF16 autocast.\n    for case in train[:4] + [evaluation[i] for i in (0, 1, 9)]:\n        prompt, full = m[\"render_ids\"](tok, case)\n        ids = torch.tensor([full], device=\"cuda\")\n        labels = torch.tensor([[-100] * len(prompt) + full[len(prompt):]], device=\"cuda\")\n        for autocast in (False, True):\n            with torch.inference_mode(), torch.autocast(\"cuda\", dtype=torch.bfloat16, enabled=autocast):\n                loss = model(input_ids=ids, attention_mask=torch.ones_like(ids), labels=labels, use_cache=False).loss\n            emit({\"kind\": \"loss\", \"case_id\": case[\"case_id\"], \"autocast_bf16\": autocast, \"loss\": loss.item()})\n\n    def probe(case, group, messages=None, autocast=False, cache=True, sample=False,\n              thinking=False, cap=128, disable=False):\n        messages = case[\"messages\"] if messages is None else messages\n        inputs = tok.apply_chat_template(messages, tokenize=True, add_generation_prompt=True,\n                                        enable_thinking=thinking, return_tensors=\"pt\").to(\"cuda\")\n        torch.manual_seed(42)\n        kwargs = dict(do_sample=sample, temperature=0.7 if sample else None,\n                      top_p=0.8 if sample else None, top_k=20 if sample else None,\n                      min_p=0.0 if sample else None, max_new_tokens=cap, use_cache=cache,\n                      pad_token_id=tok.pad_token_id)\n        # disable_adapter is a base-only control; no weights are merged or modified.\n        with torch.inference_mode(), torch.autocast(\"cuda\", dtype=torch.bfloat16, enabled=autocast):\n            with model.disable_adapter() if disable else contextlib.nullcontext():\n                output = model.generate(input_ids=inputs, attention_mask=torch.ones_like(inputs), **kwargs)\n        new = output[0, inputs.shape[1]:].tolist()\n        text = tok.decode(new, skip_special_tokens=True)\n        assessed = m[\"assess\"](case, \"npc-merchant\", \"npc-merchant\", None, None, text, None, \"peft\")\n        emit({\"kind\": \"generation\", \"group\": group, \"messages\": messages,\n              \"thinking\": thinking, \"autocast_bf16\": autocast, \"base_only\": disable,\n              \"seed\": 42, \"kwargs\": kwargs, \"generated_token_ids\": new, \"generated_tokens\": len(new),\n              \"last_token_id\": new[-1] if new else None, \"expected_completion\": case[\"completion\"],\n              \"exact_match\": text == case[\"completion\"], **assessed})\n\n    for case in train[:4]:\n        probe(case, \"train_greedy\")\n    for index in (0, 1, 9):\n        probe(evaluation[index], \"eval_greedy\")\n    for case in (train[0], evaluation[0]):\n        probe(case, \"autocast_greedy\", autocast=True)\n        probe(case, \"no_cache_greedy\", cache=False)\n\n    # One-factor counterfactuals keep eval-000's entity/value and target unchanged.\n    case = evaluation[0]\n    for group, template, state in (\n        (\"swap_template_eval1\", m[\"EVAL_TEMPLATES\"][1], \"foggy\"),\n        (\"swap_state_dawn\", m[\"EVAL_TEMPLATES\"][0], \"dawn\"),\n        (\"swap_template_train0\", m[\"TRAIN_TEMPLATES\"][0], \"foggy\"),\n    ):\n        prompt = template.format(entity=case[\"entity\"], value=case[\"value\"], state=state)\n        probe(case, group, messages=[{\"role\": \"user\", \"content\": prompt}])\n\n    # Sampling/mode probes are exploratory, not substitutes for deterministic gate scores.\n    for index in (0, 1):\n        probe(evaluation[index], \"adapter_sample\", sample=True)\n    probe(evaluation[0], \"adapter_sample_budget512\", sample=True, cap=512)\n    probe(evaluation[0], \"adapter_thinking_budget512\", sample=True, thinking=True, cap=512)\n\n    # Explicit schema makes the base's task specified; this is NOT adapter distinguishability.\n    case = evaluation[0]\n    instruction = ('Act as npc-merchant. Return only one JSON object with keys dialogue, price_gold, role. '\n                   'Set role to \"npc-merchant\", price_gold to the event value, and dialogue to '\n                   '\"<site> costs <value> gold.\" using the actual site and value.\\n')\n    messages = [{\"role\": \"user\", \"content\": instruction + case[\"messages\"][0][\"content\"]}]\n    probe(case, \"base_explicit_greedy\", messages=messages, disable=True)\n    probe(case, \"base_explicit_sample\", messages=messages, disable=True, sample=True, cap=512)\n    probe(case, \"base_explicit_thinking\", messages=messages, disable=True, sample=True, thinking=True, cap=512)\n    emit({\"kind\": \"complete\", \"exit_code\": 0, \"utc\": datetime.now(timezone.utc).isoformat()})\nexcept BaseException as exc:\n    emit({\"kind\": \"fatal\", \"error\": repr(exc), \"traceback\": traceback.format_exc(), \"exit_code\": 1})\n    raise\nfinally:\n    out.close()\n", "purpose": "exploratory, not acceptance", "adapter": "artifacts/private/m2p/20260904-m2p-lora-r01/raw/training/npc-merchant-s080/adapter", "versions": {"torch": "2.13.0a0+9186a08b2c.nv26.7.59513937", "transformers": "4.57.6", "peft": "0.20.0"}}
