{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-summary.schema.json",
  "title": "M1 single-node vLLM derived summary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "generated_at_utc",
    "raw_record_counts",
    "cases",
    "concurrency_summary",
    "raw_validation",
    "raw_validation_passed"
  ],
  "$defs": {
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "pressureIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "threshold"],
      "properties": {
        "metric": {
          "enum": ["max_waiting_requests", "max_kv_cache_usage_ratio"]
        },
        "operator": {"const": ">"},
        "threshold": {"type": "number", "minimum": 0}
      }
    },
    "selectionCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_min_concurrency",
        "safe_max_concurrency",
        "throughput_metric",
        "throughput_marginal_floor_ratio",
        "latency_metrics",
        "latency_multiplier_ceiling",
        "pressure_indicators"
      ],
      "properties": {
        "safe_min_concurrency": {"type": "integer", "minimum": 1},
        "safe_max_concurrency": {"type": "integer", "minimum": 1},
        "throughput_metric": {"const": "output_token_throughput_tps"},
        "throughput_marginal_floor_ratio": {
          "description": "Minimum current delta-TPS-per-delta-concurrency divided by the first positive delta-TPS-per-delta-concurrency.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ttft_p95_seconds", "e2e_p95_seconds"]}
        },
        "latency_multiplier_ceiling": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "pressure_indicators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pressureIndicator"}
        }
      }
    },
    "boundaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_concurrency",
        "step",
        "maximum_concurrency",
        "minimum_health_check",
        "stop_conditions"
      ],
      "properties": {
        "start_concurrency": {"type": "integer", "minimum": 1},
        "step": {"type": "integer", "minimum": 1},
        "maximum_concurrency": {"type": "integer", "minimum": 1},
        "minimum_health_check": {"const": "measured_streaming_case"},
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "client_failure",
              "request_timeout",
              "idle_failure",
              "readiness_loss",
              "oom",
              "restart"
            ]
          }
        }
      }
    },
    "latencyAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "observed_value",
        "multiplier_vs_first_point",
        "above_ceiling"
      ],
      "properties": {
        "metric": {"enum": ["ttft_p95_seconds", "e2e_p95_seconds"]},
        "observed_value": {"type": ["number", "null"]},
        "multiplier_vs_first_point": {"type": ["number", "null"]},
        "above_ceiling": {"type": ["boolean", "null"]}
      }
    },
    "pressureIndicatorAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "threshold",
        "observed_value",
        "matched"
      ],
      "properties": {
        "metric": {
          "enum": ["max_waiting_requests", "max_kv_cache_usage_ratio"]
        },
        "operator": {"const": ">"},
        "threshold": {"type": "number", "minimum": 0},
        "observed_value": {"type": ["number", "null"]},
        "matched": {"type": ["boolean", "null"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 2},
    "enrichment_schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "run",
        "experiment",
        "environment",
        "observed_server",
        "configuration",
        "fingerprints"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "run": {
          "type": "object",
          "properties": {
            "outcome": {"type": ["string", "null"]},
            "failure_phase": {"type": ["string", "null"]},
            "warnings": {
              "type": "array",
              "items": {"type": "string"}
            },
            "stop_reason": {"type": ["string", "null"]},
            "last_supported_case": {"type": ["string", "null"]},
            "first_unsupported_case": {"type": ["string", "null"]}
          }
        },
        "experiment": {
          "type": "object",
          "properties": {
            "selection_criteria": {"$ref": "#/$defs/selectionCriteria"},
            "boundary_policy": {"$ref": "#/$defs/boundaryPolicy"}
          }
        },
        "environment": {"type": "object"},
        "observed_server": {
          "type": "object",
          "properties": {
            "shutdown": {
              "type": "object",
              "properties": {
                "oom_killed": {"enum": ["true", "false", "unknown"]},
                "restart_count": {
                  "type": "string",
                  "pattern": "^(unknown|[0-9]+)$"
                },
                "container_exit_code": {
                  "type": "string",
                  "pattern": "^(unknown|-?[0-9]+)$"
                }
              }
            }
          }
        },
        "configuration": {
          "type": "object",
          "properties": {
            "orchestration": {
              "type": "object",
              "properties": {
                "stop_on_failure": {"type": "boolean"}
              }
            }
          }
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_sha256",
            "model_sha256",
            "runtime_sha256",
            "workload_sha256",
            "measurement_plan_sha256"
          ],
          "properties": {
            "config_sha256": {"$ref": "#/$defs/sha256OrNull"},
            "model_sha256": {"$ref": "#/$defs/sha256OrNull"},
            "runtime_sha256": {"$ref": "#/$defs/sha256OrNull"},
            "workload_sha256": {"$ref": "#/$defs/sha256OrNull"},
            "measurement_plan_sha256": {"$ref": "#/$defs/sha256OrNull"}
          }
        },
        "context_warnings": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_schema_valid",
        "measured_case_count",
        "complete_case_count"
      ],
      "properties": {
        "raw_schema_valid": {"type": "boolean"},
        "measured_case_count": {"type": "integer", "minimum": 0},
        "complete_case_count": {"type": "integer", "minimum": 0}
      }
    },
    "selection_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation",
        "criteria",
        "baseline_concurrency",
        "points"
      ],
      "properties": {
        "interpretation": {"const": "annotations_only"},
        "criteria": {"$ref": "#/$defs/selectionCriteria"},
        "baseline_concurrency": {"type": ["integer", "null"], "minimum": 1},
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concurrency",
              "throughput_gain_ratio_vs_previous",
              "throughput_marginal_tps_per_concurrency",
              "throughput_marginal_ratio",
              "throughput_below_floor",
              "latency",
              "pressure_indicators"
            ],
            "properties": {
              "concurrency": {"type": "integer", "minimum": 1},
              "throughput_gain_ratio_vs_previous": {
                "type": ["number", "null"]
              },
              "throughput_marginal_tps_per_concurrency": {
                "type": ["number", "null"]
              },
              "throughput_marginal_ratio": {
                "description": "Current delta-TPS-per-delta-concurrency divided by the first positive delta-TPS-per-delta-concurrency.",
                "type": ["number", "null"]
              },
              "throughput_below_floor": {"type": ["boolean", "null"]},
              "latency": {
                "type": "array",
                "items": {"$ref": "#/$defs/latencyAnnotation"}
              },
              "pressure_indicators": {
                "type": "array",
                "items": {"$ref": "#/$defs/pressureIndicatorAnnotation"}
              }
            }
          }
        }
      }
    },
    "raw_record_counts": {"type": "object"},
    "cases": {
      "type": "array",
      "items": {"type": "object"}
    },
    "concurrency_summary": {
      "type": "array",
      "items": {"type": "object"}
    },
    "raw_validation": {"type": "object"},
    "raw_validation_passed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"required": ["enrichment_schema_version"]},
      "then": {
        "required": ["context"],
        "properties": {
          "cases": {
            "items": {
              "type": "object",
              "required": [
                "run_id",
                "config_fingerprint",
                "case_contract_fingerprint",
                "case_id",
                "concurrency",
                "repetition",
                "measurement_complete",
                "completeness"
              ],
              "properties": {
                "run_id": {"type": "string", "minLength": 1},
                "config_fingerprint": {"$ref": "#/$defs/sha256OrNull"},
                "case_contract_fingerprint": {"$ref": "#/$defs/sha256OrNull"},
                "case_id": {"type": "string", "minLength": 1},
                "concurrency": {"type": "integer", "minimum": 1},
                "repetition": {"type": "integer", "minimum": 1},
                "measurement_complete": {"type": "boolean"},
                "completeness": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["client", "runtime", "system"],
                  "properties": {
                    "client": {"type": "boolean"},
                    "runtime": {"type": "boolean"},
                    "system": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "concurrency_summary": {
            "items": {
              "type": "object",
              "required": [
                "run_id",
                "config_fingerprint",
                "case_contract_fingerprint",
                "concurrency",
                "repetition_count",
                "complete_repetition_count",
                "case_ids"
              ],
              "properties": {
                "run_id": {"type": "string", "minLength": 1},
                "config_fingerprint": {"$ref": "#/$defs/sha256OrNull"},
                "case_contract_fingerprint": {"$ref": "#/$defs/sha256OrNull"},
                "concurrency": {"type": "integer", "minimum": 1},
                "repetition_count": {"type": "integer", "minimum": 0},
                "complete_repetition_count": {"type": "integer", "minimum": 0},
                "case_ids": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
