{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request-metrics.schema.jsonl",
  "title": "vLLM benchmark request record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "run_id", "case_id", "measured",
    "model", "request_id", "request_index", "concurrency", "repetition",
    "start_wall_utc", "end_wall_utc", "start_monotonic_ns",
    "response_headers_monotonic_ns", "first_content_monotonic_ns",
    "last_content_monotonic_ns", "end_monotonic_ns", "input_tokens",
    "output_tokens", "token_count_source", "stream_event_count",
    "content_chunk_count", "ttft_seconds", "decode_seconds", "tpot_seconds",
    "e2e_seconds", "http_status", "finish_reason", "response_request_id",
    "request_id_verified", "success", "timeout", "error_type", "error_message"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "request"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "measured": {"type": "boolean"},
    "model": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "request_index": {"type": "integer", "minimum": 1},
    "concurrency": {"type": "integer", "minimum": 1},
    "repetition": {"type": "integer", "minimum": 0},
    "start_wall_utc": {"type": "string", "format": "date-time"},
    "end_wall_utc": {"type": "string", "format": "date-time"},
    "start_monotonic_ns": {"type": "integer", "minimum": 0},
    "response_headers_monotonic_ns": {"type": ["integer", "null"], "minimum": 0},
    "first_content_monotonic_ns": {"type": ["integer", "null"], "minimum": 0},
    "last_content_monotonic_ns": {"type": ["integer", "null"], "minimum": 0},
    "end_monotonic_ns": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "token_count_source": {"enum": ["server_usage", "unavailable"]},
    "stream_event_count": {"type": "integer", "minimum": 0},
    "content_chunk_count": {"type": "integer", "minimum": 0},
    "ttft_seconds": {"type": ["number", "null"], "minimum": 0},
    "decode_seconds": {"type": ["number", "null"], "minimum": 0},
    "tpot_seconds": {"type": ["number", "null"], "minimum": 0},
    "e2e_seconds": {"type": "number", "minimum": 0},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "finish_reason": {"type": ["string", "null"]},
    "response_request_id": {"type": ["string", "null"]},
    "request_id_verified": {"type": "boolean"},
    "success": {"type": "boolean"},
    "timeout": {"type": "boolean"},
    "error_type": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]}
  }
}
