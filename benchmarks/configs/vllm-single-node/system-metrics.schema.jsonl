{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-metrics.schema.jsonl",
  "title": "vLLM container and host system metric sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "run_id", "timestamp_utc",
    "monotonic_ns", "elapsed_seconds", "configured_interval_seconds",
    "sample_duration_seconds", "sample_success", "errors",
    "cgroup_memory_current_bytes", "cgroup_memory_peak_bytes",
    "cgroup_memory_high_bytes", "cgroup_memory_max_bytes",
    "cgroup_memory_swap_current_bytes", "cgroup_memory_events_high_total",
    "cgroup_memory_events_max_total", "cgroup_memory_events_oom_total",
    "cgroup_memory_events_oom_kill_total", "host_memory_total_bytes",
    "host_memory_available_bytes", "host_swap_total_bytes",
    "host_swap_free_bytes", "host_pgscan_kswapd_total",
    "host_pgsteal_kswapd_total", "host_pswpin_total", "host_pswpout_total",
    "gpu_utilization_percent", "gpu_memory_used_mib", "gpu_temperature_c",
    "gpu_power_watts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "system_sample"},
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "configured_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
    "sample_duration_seconds": {"type": "number", "minimum": 0},
    "sample_success": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "cgroup_memory_current_bytes": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_peak_bytes": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_high_bytes": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_max_bytes": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_swap_current_bytes": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_events_high_total": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_events_max_total": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_events_oom_total": {"type": ["integer", "null"], "minimum": 0},
    "cgroup_memory_events_oom_kill_total": {"type": ["integer", "null"], "minimum": 0},
    "host_memory_total_bytes": {"type": ["integer", "null"], "minimum": 0},
    "host_memory_available_bytes": {"type": ["integer", "null"], "minimum": 0},
    "host_swap_total_bytes": {"type": ["integer", "null"], "minimum": 0},
    "host_swap_free_bytes": {"type": ["integer", "null"], "minimum": 0},
    "host_pgscan_kswapd_total": {"type": ["integer", "null"], "minimum": 0},
    "host_pgsteal_kswapd_total": {"type": ["integer", "null"], "minimum": 0},
    "host_pswpin_total": {"type": ["integer", "null"], "minimum": 0},
    "host_pswpout_total": {"type": ["integer", "null"], "minimum": 0},
    "gpu_utilization_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "gpu_fb_memory_status": {"type": "string", "enum": ["unsupported", "ok", "error"]},
    "gpu_memory_used_mib": {"type": ["number", "null"], "minimum": 0},
    "gpu_temperature_c": {"type": ["number", "null"]},
    "gpu_power_watts": {"type": ["number", "null"], "minimum": 0},
    "container_nvml_process_gpu_memory_used_bytes": {"type": ["integer", "null"], "minimum": 0}
  }
}
